# Karte (siehe src/map/tiles.ts). Ohne Angaben: OpenFreeMap „dark“ – kostenlos, kein Key nötig.
# Datei nach .env.local kopieren und ausfüllen – .env.local wird nicht committet.
# EXPO_PUBLIC_MAP_PROVIDER=maptiler      # openfreemap | maptiler | stadia | custom
# EXPO_PUBLIC_MAP_KEY=                   # öffentlicher Client-Key, auf eigene Domains beschränken
# EXPO_PUBLIC_MAP_STYLE=dark             # openfreemap: dark | fiord | positron | liberty
